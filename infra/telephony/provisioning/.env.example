# Twilio account credentials (Console > Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Number search criteria
TWILIO_NUMBER_COUNTRY=US
TWILIO_NUMBER_AREA_CODE=512

# SIP trunk config
TWILIO_TRUNK_FRIENDLY_NAME=propview-voice-agent

# Where Twilio should forward inbound calls (the LiveKit SIP gateway from PROP-102).
# Placeholder until PROP-102 stands up the gateway.
LIVEKIT_SIP_ORIGINATION_URI=sip:placeholder.livekit-sip-gateway.example.com
