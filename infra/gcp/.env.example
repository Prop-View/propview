# GCP project must already exist with billing enabled and the
# Compute Engine API turned on (gcloud services enable compute.googleapis.com).
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a
GCP_REGION=us-central1

VM_NAME=propview-livekit-vm
MACHINE_TYPE=e2-medium
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud
