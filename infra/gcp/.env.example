# GCP project must already exist with billing enabled and the
# Compute Engine API turned on (gcloud services enable compute.googleapis.com).
GCP_PROJECT_ID=
GCP_ZONE=us-central1-a
GCP_REGION=us-central1

VM_NAME=propview-livekit-vm
MACHINE_TYPE=e2-medium
IMAGE_FAMILY=ubuntu-2204-lts
IMAGE_PROJECT=ubuntu-os-cloud

# Comma-separated CIDRs allowed to reach the SIP/RTP firewall rule (e.g.
# Twilio's published SIP signaling IP ranges). Leave unset only for a
# throwaway/local test environment -- unset defaults to 0.0.0.0/0 (open to
# the whole internet), which combined with an unrestricted
# infra/livekit/inbound-trunk.json allows anyone to place free calls into
# the Gemini-backed agent.
SIP_SOURCE_RANGES=
