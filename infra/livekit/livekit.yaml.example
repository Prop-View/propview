# LiveKit media server config.
# Copy to livekit.yaml, fill in real values, keep livekit.yaml out of git
# (it holds the API key/secret every other service authenticates with).

port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  # Set to the VM's public IP so ICE candidates are reachable from PSTN/WebRTC callers.
  use_external_ip: true

keys:
  # api_key: api_secret — generate with `lk create-token` or any random 32+ char secret.
  REPLACE_WITH_API_KEY: REPLACE_WITH_API_SECRET

logging:
  level: info
