DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Backs rate_limit.py's per-tenant request throttling. Not shared state
# with any other service's Redis usage in any meaningful way -- just
# needs *a* Redis, same instance as tool-router's is fine locally.
REDIS_URL=redis://localhost:6379

# Per-tenant rate limits (rate_limit.py). Optional -- sensible defaults
# apply if unset (30 requests/60s general, 5 requests/60s for
# provisioning specifically -- see PROVISION_LIMIT in rate_limit.py).
RATE_LIMIT_ADMIN_REQUESTS_PER_WINDOW=30
RATE_LIMIT_PROVISION_REQUESTS_PER_WINDOW=5
# Dashboard reads use an independent per-tenant budget so frequent refreshes
# do not consume the write/API budget.
RATE_LIMIT_DASHBOARD_REQUESTS_PER_WINDOW=300
RATE_LIMIT_AUTH_REQUESTS_PER_WINDOW=30
RATE_LIMIT_WINDOW_SECONDS=60

# Short-lived dashboard sessions (default: 8 hours).
SESSION_TTL_SECONDS=28800
DASHBOARD_BASE_URL=http://localhost:5173

# Provider-agnostic email adapter currently uses SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Google Calendar OAuth. The redirect URI must exactly match the URI
# registered in the Google Cloud OAuth client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/auth/calendar/google/callback
GOOGLE_OAUTH_STATE_SECRET=

# Document upload uses the same Gemini embedding model as db/ingestion.
GEMINI_API_KEY=

# Razorpay subscriptions are restricted to test-mode API keys (rzp_test_).
# Configure the plan catalog with matching Razorpay test plan IDs before
# enabling checkout. The webhook secret is configured in the Razorpay test
# dashboard for POST /webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120

# Gates POST /admin/tenants/{tenant_id}/provision -- the platform-operator-
# only action that mints a new tenant's own admin API key (see auth.py).
# Not shared with any other service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_OPERATOR_TOKEN=
# Local Admin API listens on port 8001; dashboard VITE_API_URL should match.
CORS_ORIGINS=http://localhost:5173
