DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Backs rate_limit.py's per-tenant request throttling. Not shared state
# with any other service's Redis usage in any meaningful way -- just
# needs *a* Redis, same instance as tool-router's is fine locally.
REDIS_URL=redis://localhost:6379

# Per-tenant rate limits (rate_limit.py). Optional -- sensible defaults
# apply if unset (30 requests/60s general, 5 requests/60s for
# provisioning specifically -- see PROVISION_LIMIT in rate_limit.py).
RATE_LIMIT_ADMIN_REQUESTS_PER_WINDOW=30
RATE_LIMIT_PROVISION_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SECONDS=60

# Gates POST /admin/tenants/{tenant_id}/provision -- the platform-operator-
# only action that mints a new tenant's own admin API key (see auth.py).
# Not shared with any other service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PLATFORM_OPERATOR_TOKEN=
