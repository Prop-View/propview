# Must be a non-superuser role for PROP-601's RLS to actually enforce
# anything -- Postgres always bypasses RLS for superusers. See
# db/migrations/000_create_app_role.sql.
DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# Needed by search_knowledge_base (embeds the query) -- same key as
# services/gemini-client/.env.
GEMINI_API_KEY=

REDIS_URL=redis://localhost:6379

# Shared-secret auth for the one legitimate caller of this internal
# service -- the orchestrator (see auth.py, and
# ../../infra/observability/SECURITY_AUDIT.md section 3). Same value as
# services/orchestrator/.env's INTERNAL_SERVICE_TOKEN -- generating two
# independent values here would make the orchestrator unable to
# authenticate against this service. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=

# Needed by book_site_visit's calendar-credential decryption -- same key
# as services/admin-api/.env. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Needed by book_site_visit's PROP-404 confirmation SMS
# (../scheduling/sms_dispatch.py). Optional -- if unset, booking still
# succeeds and the confirmation SMS is skipped (best-effort, see that
# module's docstring).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=

# Per-tenant rate limiting on /tools/call (rate_limit.py). Optional --
# sensible defaults (120 requests / 10s per tenant) apply if unset.
RATE_LIMIT_TOOL_CALLS_PER_WINDOW=120
RATE_LIMIT_WINDOW_SECONDS=10
