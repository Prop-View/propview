# Must be a non-superuser role for PROP-601's RLS to actually enforce
# anything -- Postgres always bypasses RLS for superusers. See
# db/migrations/000_create_app_role.sql.
DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# Needed by search_knowledge_base (embeds the query) -- same key as
# services/gemini-client/.env.
GEMINI_API_KEY=

REDIS_URL=redis://localhost:6379

# Needed by book_site_visit's calendar-credential decryption -- same key
# as services/admin-api/.env. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Needed by book_site_visit's PROP-404 confirmation SMS
# (../scheduling/sms_dispatch.py). Optional -- if unset, booking still
# succeeds and the confirmation SMS is skipped (best-effort, see that
# module's docstring).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=
