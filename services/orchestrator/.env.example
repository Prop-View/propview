REDIS_URL=redis://localhost:6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Same key as services/gemini-client/.env -- main.py needs it directly
# since it constructs GeminiLiveSession itself.
GEMINI_API_KEY=

TOOL_ROUTER_URL=http://localhost:8000
TENANT_ID=default

# Optional -- if unset, transcript saving (PII-masked, to `interactions`) is skipped.
DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# PROP-503/504 -- human broker's cell phone (E.164, e.g. +15125551234).
# Optional -- if unset, transfer_to_human_agent replies with a "not
# available" error to Gemini instead of failing the call.
BROKER_PHONE_NUMBER=

# Same Twilio creds as services/scheduling/ -- main.py needs
# TWILIO_SMS_FROM_NUMBER set too for the PROP-504 pre-transfer SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# PROP-501/502 -- cascaded fallback (Deepgram + GPT-4o-mini + Cartesia).
# Optional -- all four unset disables the fallback entirely; see
# ../fallback-pipeline/README.md.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
FALLBACK_LATENCY_THRESHOLD_MS=1200
