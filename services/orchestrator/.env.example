REDIS_URL=redis://localhost:6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Same key as services/gemini-client/.env -- main.py needs it directly
# since it constructs GeminiLiveSession itself.
GEMINI_API_KEY=

TOOL_ROUTER_URL=http://localhost:8000
TENANT_ID=default

# Optional -- if unset, transcript saving (PII-masked, to `interactions`) is skipped.
DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev
