# Free key from https://aistudio.google.com/apikey — no billing required
# for the free tier / rate limits.
GEMINI_API_KEY=

# Defaults to gemini-3.1-flash-live-preview if unset.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Optional -- picks one of Gemini's 30 prebuilt voices (shared with the
# Cloud TTS voice set). Unset = Gemini's own default voice. See
# PREBUILT_VOICES in gemini_live_client.py for the full list with each
# voice's one-word character (e.g. Kore=Firm, Puck=Upbeat, Sulafat=Warm).
# Not validated client-side -- an unrecognized name surfaces as a Live API
# connect-time error, not a local one.
GEMINI_VOICE_NAME=
