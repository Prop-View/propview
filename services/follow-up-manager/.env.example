# Same role/caveats as ../tool-router/.env.example -- a non-superuser
# role is required for PROP-601's RLS to actually enforce anything.
DATABASE_URL=postgresql://propview_app:devpassword@localhost/propview_dev

# Same Twilio account as ../scheduling/sms_dispatch.py. Required here --
# unlike book_site_visit's confirmation SMS, a follow-up with no way to
# send it has no useful fallback, so an unset value means scans run but
# log a warning and send nothing (see followup_scan.py).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# Fallback agency name used when DATABASE_URL is unset or a tenant has no
# tenant_settings.agency_name row yet -- same pattern as
# ../orchestrator/main.py's AGENCY_NAME.
AGENCY_NAME=our brokerage

# How long after a missed slot / a stale call before each follow-up
# fires. Defaults match what was agreed for the initial rollout.
NO_SHOW_FOLLOWUP_DELAY_HOURS=1
NURTURE_FOLLOWUP_DELAY_DAYS=2

# Comma-separated tenant_ids to scan. Deliberate simplification, not a
# real tenant registry -- see followup_scan.py's module docstring.
FOLLOWUP_TENANT_IDS=default
